# Copie para .env e preencha. O .env é ignorado pelo git.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> service_role
#
# Esta chave IGNORA o RLS e pode ler e apagar tudo. Ela existe para a carga
# rodar do seu computador, e não pode ir para o site, para o navegador nem
# para o git. Se vazar, gere outra em Project Settings -> API.
SUPABASE_SERVICE_KEY=

# nome do bucket do Storage onde as fotos vão parar
SUPABASE_BUCKET=imoveis
