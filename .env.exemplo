# Copie para .env e preencha. O .env é ignorado pelo git.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> service_role
#
# Esta chave IGNORA o RLS e pode ler e apagar tudo. Ela existe para a carga
# rodar do seu computador, e não pode ir para o site, para o navegador nem
# para o git. Se vazar, gere outra em Project Settings -> API.
SUPABASE_SERVICE_KEY=

# nome do bucket do Storage onde as fotos vão parar
SUPABASE_BUCKET=imoveis

# ---------------------------------------------------------------------
# Envio para o WhatsApp do plantão (api/plantao.js)
# Estas vão nas variáveis de ambiente da VERCEL, não neste arquivo —
# aqui ficam só de referência. Sem nenhuma delas, o site continua
# funcionando e cai no wa.me, que abre a conversa em vez de enviar.
# ---------------------------------------------------------------------

# Número que RECEBE o pedido, com país e DDD, só dígitos
PLANTAO_NUMERO=5551997668999

# --- Caminho A: API oficial da Meta -----------------------------------
# Exige o número na plataforma WhatsApp Business da Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nome do modelo aprovado. Mensagem que a empresa inicia, fora de uma
# conversa aberta nas últimas 24 h, PRECISA ser modelo — texto livre é
# recusado pela Meta.
WHATSAPP_TEMPLATE=

# --- Caminho B: gateway ligado ao número que já existe -----------------
# Recebe um POST em JSON e entrega. Serve para Z-API, Evolution, n8n,
# Make. É a via curta para quem não quer migrar o número para a Meta.
PLANTAO_WEBHOOK=
